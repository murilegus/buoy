<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.buoy" path="/org/gnome/shell/extensions/buoy/">
    <key name="modules-media" type="b"><default>true</default></key>
    <key name="modules-notification" type="b"><default>true</default></key>
    <key name="modules-hud" type="b"><default>true</default></key>
    <key name="modules-home" type="b"><default>true</default></key>
    <key name="modules-progress" type="b"><default>true</default></key>
    <key name="modules-timer" type="b"><default>true</default></key>
    <key name="modules-calendar" type="b"><default>true</default></key>
    <key name="modules-copied" type="b"><default>true</default></key>
    <key name="modules-layout" type="b"><default>true</default></key>
    <key name="modules-ask" type="b"><default>true</default></key>
    <key name="modules-clipboard" type="b"><default>true</default></key>
    <key name="apps-hidden" type="as"><default>[]</default></key>
    <key name="apps-plain" type="as"><default>[]</default></key>
    <key name="idle-content" type="s"><default>"none"</default></key>
    <key name="tabs-pinned" type="as"><default>[]</default></key>
    <key name="tabs-slot" type="s">
      <default>""</default>
      <summary>Standalone tab in the strip's slot</summary>
      <description>Set by choosing a tab from ⋯. Empty or not enabled: the first enabled standalone tab.</description>
    </key>
    <key name="cluster-background" type="s"><default>"hover"</default></key>
    <key name="cluster-contrast" type="s"><default>"auto"</default></key>
    <key name="left-cluster-empty" type="s"><default>"workspace"</default></key>
    <key name="expanded-width" type="i">
      <default>0</default>
      <summary>Expanded island width in logical px</summary>
      <description>0 derives it from the monitor (560–760 px). Height is not a setting: the expanded island fits its content, up to half its width.</description>
    </key>
    <key name="dev-mode" type="b"><default>false</default></key>
    <key name="keybind-focus" type="as">
      <default><![CDATA[['<Super>b']]]></default>
      <summary>Focus the island</summary>
      <description>Takes the keyboard: ←/→ between pills, Enter opens, Esc or this key again lets go; an open ask answers to the key printed on its buttons.</description>
    </key>
  </schema>
</schemalist>
