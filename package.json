{
  "name": "buoy",
  "version": "0.0.1",
  "private": true,
  "description": "Buoy — a living pill for the GNOME Shell top bar. Lights up when it matters.",
  "scripts": {
    "check": "tsc -p jsconfig.json",
    "dev": "scripts/dev.sh",
    "link": "scripts/link.sh",
    "lint": "eslint src",
    "pack": "scripts/pack.sh",
    "test": "tests/run.sh"
  },
  "keywords": [
    "gnome-shell-extension",
    "gnome",
    "dynamic-island",
    "live-activities",
    "top-bar",
    "gjs",
    "ubuntu"
  ],
  "author": "Murilegus <murilegus@outlook.com>",
  "license": "GPL-2.0-or-later",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@girs/gjs": "^5.6.0",
    "@girs/gnome-shell": "^50.0.4",
    "eslint": "^9.39.5",
    "eslint-config-gnome": "git+https://gitlab.gnome.org/World/javascript/eslint-config-gnome.git#c479d059e8d9ea99c3b53c2ea43abf7fdb05eb51",
    "typescript": "^5.9.0"
  }
}
